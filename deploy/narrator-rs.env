# /etc/narrator-rs.env — the Oracle A1's configuration.
#
# Everything here is read by the container. Templates: applied by hand, like the
# python repo's deploy/, because a deploy that a playbook can do unattended is a
# deploy that can happen while Fernando is listening.

# The vault is mounted at /vault inside the container; this is the path *there*.
NARRATOR_VAULT=/vault
POSITIONS_SUBDIR=02 - Studies
NOTES_SUBDIR=05 - Fleeting
BOOKS_SUBDIR=03 - Resources/Books

KOKORO_VOICE=af_heart
# The voice-memo transcriber is Phonon-2, read from /models/phonon-2 (fetched
# by scripts/fetch-models.sh). It takes no prompt and needs no model name, so
# there is nothing to set; STT_MODEL and STT_THREADS exist if that changes.
# WHISPER_MODEL and WHISPER_PROMPT are no longer read.

# The A1 renders at roughly realtime, so the buffer ahead of the playhead is
# what keeps listening continuous.
LOOKAHEAD=80
PRERENDER_CHAPTERS=2

# 50 GB of chunk wavs. The packed chapters have their own, separate cap.
MAX_AUDIO_GB=50
MAX_CHAPTER_GB=20

RUST_LOG=info,tower_http=warn,ort=warn
